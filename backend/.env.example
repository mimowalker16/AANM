NODE_ENV=production
PORT=3001
TRUST_PROXY=1

# PostgreSQL
DATABASE_URL=postgres://aanm_user:change-me@your-postgres-host:5432/aanm
DATABASE_SSL=false

# API rate limiting
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX_REQUESTS=100

# CORS
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Admin authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=strong-production-password
JWT_SECRET=long-random-production-secret
JWT_EXPIRES_IN=8h

# Seminar approval confirmation emails
# Use EMAIL_PROVIDER=resend on hosts that block raw SMTP ports.
EMAIL_PROVIDER=auto
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com/emails
SMTP_HOST=
SMTP_PORT=587
# Use true with port 465, false with port 587/STARTTLS.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=AANM <no-reply@aanm-assal.org>
EMAIL_REPLY_TO=cabinet@aanm-assal.org
