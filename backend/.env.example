# Copy this file to backend/.env for local development.
# Do not commit backend/.env; it contains live database credentials.

# Supabase Transaction pooler for the AANM project.
DATABASE_URL=postgresql://
DATABASE_SSL=true
SKIP_TABLE_INIT=true
DB_POOL_MAX=5
SUPABASE_URL=https://rrpaajtctdavlhwuffsy.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_REGISTRATION_FILES_BUCKET=seminar-registration-files

# Keep local frontend requests accepted by the API server.
ALLOWED_ORIGINS=

# Local admin auth. Change these if you need different dev credentials.
ADMIN_USERNAME=
ADMIN_PASSWORD=
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Optional seminar approval confirmation emails.
# Use EMAIL_PROVIDER=resend on hosts that block raw SMTP ports.
EMAIL_PROVIDER=auto
RESEND_API_KEY=
RESEND_API_URL=
SMTP_HOST=
SMTP_PORT=587
# Use true with port 465, false with port 587/STARTTLS.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_REPLY_TO=

# Optional admin reminder for pending seminar registrations.
# Sends one reminder to EMAIL_REPLY_TO after a registration stays pending for 5 hours.
ADMIN_PENDING_REMINDER_ENABLED=true
ADMIN_PENDING_REMINDER_AFTER_HOURS=5
ADMIN_PENDING_REMINDER_INTERVAL_MINUTES=15
ADMIN_PENDING_REMINDER_RETRY_MINUTES=60
ADMIN_PENDING_REMINDER_BATCH_SIZE=25
