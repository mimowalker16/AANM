{
  "name": "@aanm/frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "build": "npm run clean && npm run optimize:css && vite build && npm run optimize:images",
    "configure:api": "node ../scripts/configure-frontend-api.js",
    "preview": "vite preview --open",
    "clean": "rimraf dist",
    "optimize": "npm run optimize:images && npm run optimize:css",
    "optimize:images": "node scripts/optimize-images.js",
    "optimize:css": "echo 'CSS optimization included in build process'",
    "check:performance": "lighthouse http://localhost:4173 --output=html --output-path=./lighthouse-report.html",
    "postbuild": "echo 'Frontend build completed successfully'"
  },
  "devDependencies": {
    "rimraf": "^5.0.5",
    "sharp": "^0.35.1",
    "terser": "^5.24.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": "20.x",
    "npm": "10.x"
  }
}
