{
  "name": "aanm-website",
  "private": true,
  "version": "1.0.0",
  "description": "Association Algerienne de Nutrition Maghrebine website",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "preview": "npm run preview --workspace frontend",
    "start": "npm start --workspace backend",
    "server": "npm start --workspace backend",
    "server:dev": "npm run dev --workspace backend",
    "full-dev": "concurrently --names \"CLIENT,SERVER\" --prefix-colors \"blue,green\" \"npm run dev --workspace frontend\" \"npm run dev --workspace backend\"",
    "migrate:postgres": "node scripts/migrate-sqlite-to-postgres.js",
    "seed:postgres": "node scripts/seed/run-seed.js",
    "format": "prettier --write .",
    "check:backend": "node --check backend/server/index.js",
    "check:frontend": "npm run build --workspace frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "dotenv": "^16.3.1",
    "pg": "^8.13.1",
    "prettier": "^3.1.1",
    "sqlite3": "^5.1.6"
  },
  "engines": {
    "node": "20.x",
    "npm": "10.x"
  }
}
